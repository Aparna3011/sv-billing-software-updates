{
  "name": "sv-billing",
  "version": "1.0.0",
  "description": "SV IT Hub Billing - Offline GST Billing & Service Management",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:renderer": "vite build",
    "dist": "npm run build && electron-builder --publish=never",
    "build": "npm run build:renderer && electron-builder --win",
    "build:portable": "npm run build:renderer && electron-builder --win portable",
    "lint": "vite build"
  },
  "dependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/register": "^7.29.3",
    "@hookform/resolvers": "^3.9.1",
    "@react-pdf/renderer": "^3.4.5",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "country-state-city": "^3.2.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.468.0",
    "number-to-words": "^1.2.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-country-state-city": "^1.1.12",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "react-toastify": "^10.0.6",
    "recharts": "^2.13.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.svithub.billing",
    "productName": "SV IT Hub Billing",
    "copyright": "Copyright (c) 2026 SV IT Hub",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SV IT Hub Billing"
    }
  }
}
